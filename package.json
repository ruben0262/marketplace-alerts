{
  "name": "marketplace-alerts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "import:profile": "node scripts/import-profile.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "playwright test",
    "test:python": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py'",
    "check:live": "node scripts/check-live.js",
    "check:deployment": "node scripts/check-deployment.js"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "framer-motion": "^12.23.24",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.20.0",
    "nodemailer": "^10.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^10.3.0",
    "supertest": "^7.1.4",
    "vite": "^7.1.12"
  }
}
