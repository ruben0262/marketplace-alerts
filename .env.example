# Copy this file to .env. Never commit the copied file.

# Telegram: required for real delivery, but not for --dry-run or --check-config.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# eBay production application keys from developer.ebay.com.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_PROXY=

# Optional Vinted HTTP proxy for VPS IPs that Vinted rejects.
# Formats: http://user:password@host:port or user:password@host:port.
VINTED_PROXY=

# Optional. Enables full title/description translation when translation.enabled is true.
DEEPL_API_KEY=

# Optional. Defaults to marketplace-alerts/<version>.
MONITOR_USER_AGENT=

# Web app. Never use a VITE_ prefix for secrets (those reach the browser).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=marketplace_alerts
# For URI templates containing <db_username> / <db_password>:
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back up this key: encrypted integrations cannot be recovered without it.
ENCRYPTION_KEY=
APP_URL=http://localhost:3000
PORT=3000
HOST=127.0.0.1
COOKIE_SECURE=false
TRUST_PROXY=false
WORKER_ENABLED=true
# Structured JSON logs go to stdout and rotating files (5 × 10 MiB).
# Docker persists this directory in the scout-data volume.
LOG_DIR=data/logs
LOG_LEVEL=info

# Email: use your own authenticated SMTP account. Port 587 requires STARTTLS;
# SMTP_SECURE=true selects implicit TLS, usually port 465.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@flow-solutions.xyz
SMTP_PASSWORD=
MAIL_FROM=no-reply@flow-solutions.xyz
# Docker public origin. Set to your HTTPS domain behind a reverse proxy.
DOCKER_APP_URL=https://scout.rubenlekli.com
DOCKER_COOKIE_SECURE=true
DOCKER_TRUST_PROXY=true
BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# One-time migration only. Remove these after npm run import:profile.
IMPORT_USERNAME=
IMPORT_PASSWORD=
